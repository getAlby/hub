# Gate secrets for the Alby Hub Caddy password gate.
#
# Install this as /etc/caddy/gate.env and keep it root-only:
#
#   sudo install -m 600 -o root -g root gate.env.example /etc/caddy/gate.env
#
# systemd reads it (as root, before Caddy drops privileges) via the drop-in in
# caddy-gate.conf and exposes the values to the Caddyfile as {env.GATE_SECRET}
# and {env.GATE_SECRET_OLD}.
#
# Anyone who learns GATE_SECRET can walk past the password prompt, so treat it
# like a password. Generate and rotate both values with rotate-gate-secret.sh
# rather than editing this file by hand.
#
# GATE_SECRET_OLD is the previous secret. It is still accepted so that rotating
# does not sign out everyone at once. Never leave either value empty.

GATE_SECRET=replace-me-with-a-long-random-string
GATE_SECRET_OLD=replace-me-with-a-different-long-random-string
